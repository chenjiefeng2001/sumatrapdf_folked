*.log
/build_*.txt
/*_diff*.txt
/diffs.txt
/ps_test.txt
/rcache_diff.txt
/tmp_*.txt 

# ---------------------------------------------------------------------------
# Local ad-hoc helper scripts (build/check/install helpers, not part of the
# real build system under cmd/; keep the official tools tracked)
# ---------------------------------------------------------------------------
