/do_build.ps1
/do_build.py
/build_fix.py
/build_release.py
/check_build.py
vs2022/add_test_file.py
vs2022/check_installer*.py
vs2022/check_resources.py
cmd/package-installer.ts
tests/_gen.py
scripts/

# ---------------------------------------------------------------------------
# Visual Studio local artifacts. The project management files themselves
# (*.sln, *.vcxproj, *.vcxproj.filters) are tracked and must stay tracked;
# only VS-local data is ignored here. (.vs/ above already covers the
# vs2022/.vs/ IntelliSense database directory.)
# ---------------------------------------------------------------------------
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.VC.opendb
*.opendb
*.browser

/mcps/tasks/tools
